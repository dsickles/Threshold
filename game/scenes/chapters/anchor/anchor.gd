extends Control
## The Anchor, rough M2 playable (DAS-138). Month 17, about eight months
## pregnant: Leo carries the crib through a storm-and-clutter version of the
## House to set it down by the living-room window. Two hold zones, low on the
## left and right where the thumbs rest, lean him that way. Beats:
## docs/design/story-beats.md §6 (Dan approved 2026-10-25): steady, then the
## storm (falls happen, none ends the chapter), then after the third fall
## Maya's "You've got this." and an invisible assist, then the crib set down.
##
## The carry itself is anchor_carry.gd (the scripted wobble, the scope's
## cheap test against real physics). Every picture here is drawn in code and
## every sound is generated: all PLACEHOLDERS (the storm shader, the shapes
## below, tools/anchor/make_placeholder_audio.py).
##
## The only words on screen, ever, are Maya's line; there is no stability
## meter, no label and no badge (UX-DR21, UX-DR31). The chapter only reports
## that it finished (no Stoic/Vulnerable answer until the Panic is built), and
## never touches the House or saved state: the chapter runner and the core
## table do that. Leaving part-way gives no result, so the next visit starts
## again at the front of the House. Hiding the tab pauses everything until
## the next tap, and never saves.

signal finished

const AnchorCarry := preload("res://scenes/chapters/anchor/anchor_carry.gd")
const AnchorZone := preload("res://scenes/chapters/anchor/anchor_zone.gd")
const STORM_SHADER := preload("res://scenes/chapters/anchor/anchor_storm.gdshader")
# PLACEHOLDER sounds, generated by tools/anchor/make_placeholder_audio.py.
const RAIN_SOUND := preload("res://assets/audio/anchor/placeholder_rain.wav")
const CREAK_SOUND := preload("res://assets/audio/anchor/placeholder_creak.wav")
const THUD_SOUND := preload("res://assets/audio/anchor/placeholder_thud.wav")
const MAYA_SOUND := preload("res://assets/audio/anchor/placeholder_maya_cue.wav")
const SET_DOWN_SOUND := preload("res://assets/audio/anchor/placeholder_set_down.wav")

const BACKGROUND := Color("#1C1916")
const WALL := Color("#3A332C")
const FLOOR := Color("#2A2520")
const FRAME := Color("#4E453B")
const WINDOW_NIGHT := Color("#1E2633")
const WINDOW_WARM := Color("#E8D4A8")
const LEO := Color("#9A9084")
const CRIB := Color("#C4A574")
const CLUTTER := Color("#5C534C")
const INK := Color("#F4EFE6")
const SUBTITLE_BG := Color("#1C1916CC")
const MARGIN := 24.0

## Leo's tallest lean on screen, in degrees, when the lean is at 1.
const LEAN_DEGREES := 32.0
## The crib tips further than he does.
const CRIB_DEGREES := 48.0
## A fall shakes the screen this long, this far (in screen units).
const SHAKE_TIME := 0.45
const SHAKE_SIZE := 14.0
## Lightning strikes as he passes these places in the storm (metres).
const LIGHTNING := [30.0, 44.5, 58.0, 71.0, 82.0, 93.0]
## Where doors and windows stand along the way (metres).
const DOORS := [4.0, 18.0, 35.0, 50.0, 67.0, 85.0]
const WINDOWS := [11.0, 27.0, 43.0, 59.0, 76.0, 93.0]
## The living-room window the crib goes under, a little past the end.
const END_WINDOW_AT := AnchorCarry.LENGTH + 1.2

## Tests turn this off and move the clock themselves with advance().
var auto_advance := true
## No hit-shake when true (EXPERIENCE.md, reduced motion). The setting itself
## comes with Settings; until then it is always off in play.
var reduced_motion := false

var _carry := AnchorCarry.new()
var _world: Control
var _storm: ColorRect
var _zones: Array = []  # Left, then right.
var _subtitle: PanelContainer
var _subtitle_label: Label
var _dim: ColorRect
var _paused := false
var _finished := false
var _touches := {}  # Finger index (-1 for the mouse) -> -1 left or 1 right.
var _shake := Vector2.ZERO
var _last_falls := 0
var _maya_heard := false
var _set_down_heard := false
var _strikes_done := 0
var _struck_at := -INF
var _creaked_at := -INF
var _rain: AudioStreamPlayer
var _creak: AudioStreamPlayer
var _thud: AudioStreamPlayer
var _maya: AudioStreamPlayer
var _set_down: AudioStreamPlayer
var _document: JavaScriptObject
var _visibility_callback: JavaScriptObject


func _ready() -> void:
	set_anchors_preset(PRESET_FULL_RECT)
	mouse_filter = MOUSE_FILTER_STOP
	var background := ColorRect.new()
	background.color = BACKGROUND
	background.set_anchors_preset(PRESET_FULL_RECT)
	background.mouse_filter = MOUSE_FILTER_IGNORE
	add_child(background)
	_world = Control.new()
	_world.name = "World"
	_world.mouse_filter = MOUSE_FILTER_IGNORE
	_world.draw.connect(_draw_world)
	add_child(_world)
	_storm = ColorRect.new()
	_storm.name = "Storm"
	_storm.mouse_filter = MOUSE_FILTER_IGNORE
	var storm_material := ShaderMaterial.new()
	storm_material.shader = STORM_SHADER
	_storm.material = storm_material
	add_child(_storm)
	for side in ["LeftZone", "RightZone"]:
		var zone: Control = AnchorZone.new()
		zone.name = side
		add_child(zone)
		_zones.append(zone)
	_build_subtitle()
	_dim = ColorRect.new()
	_dim.color = Color(0, 0, 0, 0.55)
	_dim.set_anchors_preset(PRESET_FULL_RECT)
	_dim.mouse_filter = MOUSE_FILTER_IGNORE
	_dim.visible = false
	add_child(_dim)
	_build_sound()
	resized.connect(_layout)
	_layout()
	if OS.has_feature("web"):
		_bring_sound_back()
		# Hiding the tab pauses the carry; Godot doesn't say so on the web.
		_document = JavaScriptBridge.get_interface("document")
		_visibility_callback = JavaScriptBridge.create_callback(_on_visibility_change)
		_document.addEventListener("visibilitychange", _visibility_callback)
	_update(0.0)


func _build_subtitle() -> void:
	_subtitle = PanelContainer.new()
	_subtitle.name = "Subtitle"
	_subtitle.mouse_filter = MOUSE_FILTER_IGNORE
	var box := StyleBoxFlat.new()
	box.bg_color = SUBTITLE_BG
	box.set_corner_radius_all(8)
	box.content_margin_left = 16
	box.content_margin_right = 16
	box.content_margin_top = 8
	box.content_margin_bottom = 8
	_subtitle.add_theme_stylebox_override("panel", box)
	_subtitle_label = Label.new()
	_subtitle_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_subtitle_label.add_theme_color_override("font_color", INK)
	_subtitle.add_child(_subtitle_label)
	_subtitle.visible = false
	add_child(_subtitle)


func _build_sound() -> void:
	_rain = _player(RAIN_SOUND, "Rain")
	_creak = _player(CREAK_SOUND, "Creak")
	_thud = _player(THUD_SOUND, "Thud")
	_maya = _player(MAYA_SOUND, "MayaCue")
	_set_down = _player(SET_DOWN_SOUND, "SetDown")
	# Rain on the windows from the start, quiet; it grows with the storm.
	_rain.volume_db = linear_to_db(_rain_level())
	_rain.play()


func _player(stream: AudioStream, node_name: String) -> AudioStreamPlayer:
	var player := AudioStreamPlayer.new()
	player.name = node_name
	player.stream = stream
	add_child(player)
	return player


func _exit_tree() -> void:
	if OS.has_feature("web"):
		JavaScriptBridge.eval("if (window.thresholdAnchorSound) window.thresholdAnchorSound.on = false;", true)
	if _document:
		_document.removeEventListener("visibilitychange", _visibility_callback)
		_document = null


# The two zones sit low on each side, where the thumbs are when the phone is
# held sideways; the House fills the rest. On an upright screen they share
# the bottom of it.
func _layout() -> void:
	var w := size.x
	var h := size.y
	if w <= 0.0 or h <= 0.0:
		return
	_world.position = Vector2.ZERO
	_world.size = size
	_storm.position = Vector2.ZERO
	_storm.size = size
	(_storm.material as ShaderMaterial).set_shader_parameter("aspect", w / h)
	var zone_size: Vector2
	if w >= h:
		zone_size = Vector2(clampf(w * 0.2, 150.0, 320.0), clampf(h * 0.5, 150.0, 420.0))
	else:
		zone_size = Vector2((w - MARGIN * 3.0) / 2.0, clampf(h * 0.22, 150.0, 360.0))
	_zones[0].position = Vector2(MARGIN, h - MARGIN - zone_size.y)
	_zones[1].position = Vector2(w - MARGIN - zone_size.x, h - MARGIN - zone_size.y)
	for zone: Control in _zones:
		zone.size = zone_size
	_place_subtitle()


func _place_subtitle() -> void:
	var w := size.x
	var h := size.y
	var label_size := _subtitle.get_combined_minimum_size()
	if w >= h:
		_subtitle.position = Vector2((w - label_size.x) / 2.0, h - MARGIN - label_size.y)
	else:
		_subtitle.position = Vector2((w - label_size.x) / 2.0, _zones[0].position.y - MARGIN - label_size.y)
	_subtitle.size = label_size


func _physics_process(delta: float) -> void:
	# The lean is stepped in the physics step (story 7.2); the carry also
	# keeps its own fixed step, so it plays the same at any frame rate.
	if auto_advance:
		advance(delta)


## Moves the chapter's clock on by `delta` seconds (nothing moves while paused).
func advance(delta: float) -> void:
	if _paused or _finished:
		return
	_carry.advance(delta)
	_update(delta)
	if _carry.stage == AnchorCarry.Stage.DONE:
		_finished = true
		_rain.stop()
		finished.emit()


func _update(_delta: float) -> void:
	var t: float = _carry.time
	# A fall landing: the thud, and the shake.
	if _carry.falls != _last_falls:
		_last_falls = _carry.falls
		_thud.play()
	# Maya's line, with the sound cue that stands in for her voice.
	var line: String = _carry.subtitle()
	if line != "" and not _maya_heard:
		_maya_heard = true
		_maya.play()
	if _subtitle_label.text != line:
		_subtitle_label.text = line
		_place_subtitle()
	_subtitle.visible = line != ""
	if _carry.stage == AnchorCarry.Stage.SET_DOWN and not _set_down_heard:
		_set_down_heard = true
		_set_down.play()
	# The load creaks as it leans far over.
	if _carry.is_carrying() and absf(_carry.lean) > 0.55 and t - _creaked_at > 1.5:
		_creaked_at = t
		_creak.play()
	while _strikes_done < LIGHTNING.size() and _carry.distance >= LIGHTNING[_strikes_done]:
		_strikes_done += 1
		_struck_at = t
	_rain.volume_db = linear_to_db(_rain_level())
	_shake = shake_offset()
	_world.position = _shake
	var mat := _storm.material as ShaderMaterial
	mat.set_shader_parameter("clock", t)
	mat.set_shader_parameter("storm", _carry.storm())
	mat.set_shader_parameter("flash", lightning())
	mat.set_shader_parameter("wind", clampf(_carry.wind() / 2.0, -1.0, 1.0))
	_world.queue_redraw()


func _rain_level() -> float:
	return maxf(0.12 + 0.75 * _carry.storm(), 0.0001)


## How far the screen is knocked by a fall right now (none with reduced motion).
func shake_offset() -> Vector2:
	var since: float = _carry.time - _carry.fell_at
	if reduced_motion or since < 0.0 or since >= SHAKE_TIME:
		return Vector2.ZERO
	var fade := 1.0 - since / SHAKE_TIME
	var rng := RandomNumberGenerator.new()
	rng.seed = int(_carry.time * 60.0)
	return Vector2(rng.randf_range(-1.0, 1.0), rng.randf_range(-1.0, 1.0)) * SHAKE_SIZE * fade


## 0 to 1, just after lightning.
func lightning() -> float:
	return exp(-(_carry.time - _struck_at) * 7.0) if _carry.time >= _struck_at else 0.0


# --- Drawing the House the carry goes through. Leo walks right; the House
# slides past him. Everything is simple shapes: PLACEHOLDER art.

func _draw_world() -> void:
	var w := _world.size.x
	var h := _world.size.y
	if w <= 0.0 or h <= 0.0:
		return
	var metre := minf(h * 0.2, w * 0.2)
	var floor_y := h * 0.8
	var leo_x := w * 0.4
	var at: float = _carry.distance
	var x_of := func(d: float) -> float: return leo_x + (d - at) * metre
	var warm := clampf(1.0 - (AnchorCarry.LENGTH - at) / 10.0, 0.0, 1.0)
	_world.draw_rect(Rect2(0, 0, w, floor_y), WALL.lerp(Color("#5A4A38"), warm * 0.5))
	_world.draw_rect(Rect2(0, floor_y, w, h - floor_y), FLOOR)
	_world.draw_line(Vector2(0, floor_y), Vector2(w, floor_y), FRAME, 3.0)
	var wall_top := floor_y - metre * 2.6
	for d: float in DOORS:
		var x: float = x_of.call(d)
		if x > -metre * 2.0 and x < w + metre * 2.0:
			_world.draw_rect(Rect2(x, floor_y - metre * 2.1, metre * 0.95, metre * 2.1), BACKGROUND)
			_world.draw_rect(Rect2(x, floor_y - metre * 2.1, metre * 0.95, metre * 2.1), FRAME, false, 4.0)
	for d: float in WINDOWS:
		var x: float = x_of.call(d)
		if x > -metre * 2.0 and x < w + metre * 2.0:
			var pane := Rect2(x, wall_top + metre * 0.5, metre * 1.2, metre * 0.9)
			_world.draw_rect(pane, WINDOW_NIGHT.lerp(Color(0.8, 0.85, 1.0), lightning() * 0.7))
			_world.draw_rect(pane, FRAME, false, 4.0)
			_world.draw_line(Vector2(pane.get_center().x, pane.position.y), Vector2(pane.get_center().x, pane.end.y), FRAME, 3.0)
	# The living-room window at the end, warm, the crib's place under it.
	var end_x: float = x_of.call(END_WINDOW_AT)
	if end_x < w + metre * 3.0:
		var pane := Rect2(end_x - metre * 0.2, wall_top + metre * 0.2, metre * 2.2, metre * 1.6)
		_world.draw_rect(pane, WINDOW_NIGHT.lerp(WINDOW_WARM, 0.35 + 0.65 * warm))
		_world.draw_rect(pane, FRAME, false, 5.0)
	for item: Array in AnchorCarry.CLUTTER:
		var x: float = x_of.call(item[0])
		if x > -metre and x < w + metre:
			var wide := metre * (0.35 + 0.1 * (int(item[0]) % 3))
			_world.draw_rect(Rect2(x - wide / 2.0, floor_y - metre * 0.3, wide, metre * 0.3), CLUTTER)
	_draw_leo(Vector2(leo_x, floor_y), metre)


func _draw_leo(feet: Vector2, metre: float) -> void:
	var t: float = _carry.time
	var lean: float = _carry.lean
	var shiver: float = _carry.shiver()
	var tremble := Vector2(sin(t * 63.0), cos(t * 71.0)) * shiver * metre * 0.02
	var crouch := 0.0  # 0 standing, 1 kneeling.
	var crib_on_floor := false
	if _carry.is_fallen():
		crouch = 1.0
		crib_on_floor = true
	elif _carry.is_picking_up():
		crouch = 1.0 - (t - _carry.fell_at - AnchorCarry.FALLEN_TIME) / AnchorCarry.PICK_UP_TIME
	elif _carry.stage in [AnchorCarry.Stage.SET_DOWN, AnchorCarry.Stage.DONE]:
		crouch = clampf((t - _carry.set_down_at) / 1.5, 0.0, 1.0)
		crib_on_floor = crouch >= 1.0
	var tall := metre * lerpf(1.8, 1.1, crouch)
	var tilt := deg_to_rad(LEAN_DEGREES * lean)
	# Legs, walking while he walks.
	var step := sin(_carry.distance * 6.0) * metre * 0.18 if _carry.is_carrying() else 0.0
	var hip := feet + Vector2(0, -tall * 0.45)
	_world.draw_line(hip, feet + Vector2(step, 0), LEO, metre * 0.12)
	_world.draw_line(hip, feet + Vector2(-step, 0), LEO, metre * 0.12)
	# Body and head, leaning from the hips.
	_world.draw_set_transform(hip, tilt, Vector2.ONE)
	_world.draw_rect(Rect2(-metre * 0.17, -tall * 0.42, metre * 0.34, tall * 0.42), LEO)
	_world.draw_circle(Vector2(0, -tall * 0.42 - metre * 0.16), metre * 0.15, LEO)
	_world.draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
	# The crib: in his arms in front of him, or on the floor.
	var crib_size := Vector2(metre * 1.3, metre * 0.75)
	if crib_on_floor:
		var side := float(_carry.fell_to) if _carry.is_fallen() else 1.0
		var spot := feet + Vector2(side * metre * 0.9, -crib_size.y / 2.0)
		var on_floor_tilt := deg_to_rad(12.0) * side if _carry.is_fallen() else 0.0
		_draw_crib(spot, on_floor_tilt, crib_size)
	else:
		# Held out in front at chest height, clear of his body and head.
		var arms := hip + Vector2(0, -tall * 0.3).rotated(tilt)
		var held := arms + Vector2(metre * 0.3, 0.0).rotated(tilt) + tremble
		_world.draw_line(arms, held, LEO, metre * 0.09)
		var crib_tilt := deg_to_rad(CRIB_DEGREES * lean)
		_draw_crib(held + Vector2(crib_size.x * 0.5, 0.0).rotated(crib_tilt), crib_tilt, crib_size)


func _draw_crib(centre: Vector2, angle: float, crib_size: Vector2) -> void:
	_world.draw_set_transform(centre, angle, Vector2.ONE)
	var box := Rect2(-crib_size / 2.0, crib_size)
	_world.draw_rect(box, CRIB, false, 5.0)
	for k in range(1, 7):
		var x := box.position.x + box.size.x * k / 7.0
		_world.draw_line(Vector2(x, box.position.y), Vector2(x, box.end.y), CRIB, 3.0)
	_world.draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


# --- The hold zones. Only a touch or a real click that goes down inside a
# zone holds it; it stays held until that finger lifts. Both held at once
# cancel out. Touches also arrive as emulated clicks, which are skipped so a
# press isn't counted twice. Nothing reacts to hover or to keys.

func _input(event: InputEvent) -> void:
	var finger := 0
	if event is InputEventScreenTouch:
		finger = event.index
	elif event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT \
			and event.device != InputEvent.DEVICE_ID_EMULATION:
		finger = -1
	else:
		if _paused and (event is InputEventMouse or event is InputEventScreenDrag):
			get_viewport().set_input_as_handled()
		return
	get_viewport().set_input_as_handled()
	if _paused:
		if event.pressed:
			resume()
		return
	if event.pressed:
		var side := zone_at(event.position)
		if side != 0:
			_touches[finger] = side
	else:
		_touches.erase(finger)
	_update_hold()


## -1 if `point` is in the left zone, 1 in the right, else 0.
func zone_at(point: Vector2) -> int:
	if _zones[0].get_global_rect().has_point(point):
		return -1
	if _zones[1].get_global_rect().has_point(point):
		return 1
	return 0


func _update_hold() -> void:
	var left := _touches.values().has(-1)
	var right := _touches.values().has(1)
	_zones[0].held = left
	_zones[1].held = right
	_carry.set_hold((1 if right else 0) - (1 if left else 0))


func _let_go_all() -> void:
	_touches.clear()
	_update_hold()


# --- Pause: hiding the tab stops the carry, the sound and the clocks, and
# the next tap brings them back. Never saves.

func pause() -> void:
	if _paused or _finished:
		return
	_paused = true
	_dim.visible = true
	_let_go_all()
	for player in [_rain, _creak, _thud, _maya, _set_down]:
		player.stream_paused = true


func resume() -> void:
	if not _paused:
		return
	_paused = false
	_dim.visible = false
	for player in [_rain, _creak, _thud, _maya, _set_down]:
		player.stream_paused = false


func is_paused() -> bool:
	return _paused


func _notification(what: int) -> void:
	# Native builds; the web says so through visibilitychange (see _ready).
	if what in [NOTIFICATION_APPLICATION_FOCUS_OUT, NOTIFICATION_APPLICATION_PAUSED] \
			and not OS.has_feature("web"):
		pause()


func _on_visibility_change(_args: Array) -> void:
	if _document and _document.hidden:
		pause()


# After the tab has been away, Safari can leave the page's sound stopped (the
# Loss found this, Dan, 2026-10-27). The tap that resumes restarts every
# audio context the page made, inside the browser's own tap handler, which
# is the only place a phone lets sound start.
func _bring_sound_back() -> void:
	JavaScriptBridge.eval("""
		if (!window.thresholdAnchorSound) {
			const back = window.thresholdAnchorSound = { on: false, away: false };
			document.addEventListener('visibilitychange', () => {
				if (document.hidden) back.away = true;
			});
			const tapped = () => {
				if (!back.on || document.hidden) return;
				for (const ctx of window.thresholdAudioContexts || []) {
					if (ctx.state === 'closed') continue;
					if (ctx.state !== 'running') {
						ctx.resume();
					} else if (back.away) {
						ctx.suspend();
						ctx.resume();
					}
				}
				back.away = false;
			};
			for (const type of ['touchend', 'mouseup', 'keydown']) {
				window.addEventListener(type, tapped, true);
			}
		}
		window.thresholdAnchorSound.on = true;
		window.thresholdAnchorSound.away = false;
	""", true)


# --- For tests, the playtest overlay and the browser tests.

func carry() -> RefCounted:
	return _carry


func zone(side: int) -> Control:
	return _zones[0] if side < 0 else _zones[1]


func is_sound_playing() -> bool:
	return _rain.playing and not _rain.stream_paused


func sound_heard(which: String) -> bool:
	match which:
		"thud":
			return _last_falls > 0
		"maya":
			return _maya_heard
		"set_down":
			return _set_down_heard
	return false


## Seconds into the chapter, for the playtest overlay's clock.
func playtest_time() -> float:
	return _carry.time


func probe_state() -> Dictionary:
	var zones := []
	for z: Control in _zones:
		var r := z.get_global_rect()
		zones.append({"x": r.get_center().x, "y": r.get_center().y, "w": r.size.x, "h": r.size.y})
	return {
		"stage": AnchorCarry.Stage.keys()[_carry.stage],
		"time": _carry.time,
		"distance": _carry.distance,
		"lean": _carry.lean,
		"hold": _carry.hold,
		"falls": _carry.falls,
		"subtitle": _carry.subtitle(),
		"zones": zones,
		"paused": _paused,
		"sound": is_sound_playing(),
	}
