extends Control
## The Arrival, rough M2 playable (DAS-137). Month 18, full term: the last
## chapter. Beats, in order (docs/design/story-beats.md §8, Dan approved
## 2026-10-25):
##
##   DOOR  Out the door (the levity): Maya's hospital bag is over-packed and
##         won't shut on the first try; then it does, the keys, the front door.
##   CRY   Hear the cry: static, the Tuner's two knobs and waveform, and the
##         cry comes through and the static clears (Story 8.1).
##   HAND  Hold the hand: the baby's hand round the father's finger, tapping
##         in time with the baby's heartbeat, the Partner's rhythm (Story 8.2).
##   HOME  A quiet hold: dawn, the small light, the baby breathing. Then the
##         chapter reports `finished`; the House after is the House's job.
##
## The knobs and the rhythm are copies of the Tuner's and the Partner's, in
## this folder (arrival_knob.gd, arrival_cry.gd, arrival_hand.gd,
## arrival_conductor.gd): a chapter never reaches into another chapter.
##
## No words on screen but Perfect, Good and Miss in the hand beat. No baby
## model (FR30): the baby is the cry and the hand. Every picture is drawn here
## and every sound is generated (tools/arrival/make_placeholder_audio.py):
## all PLACEHOLDERS. The look waits on Dan's photos (story-beats §8).
##
## The chapter only reports that it finished (no Stoic/Vulnerable answer),
## and never touches the House or saved state. Leaving part-way gives no
## result, so the next visit starts at the door. Hiding the tab pauses
## everything until the next tap, and never saves.

signal finished

enum Beat { DOOR, CRY, HAND, HOME, DONE }

const ArrivalCry := preload("res://scenes/chapters/arrival/arrival_cry.gd")
const ArrivalHand := preload("res://scenes/chapters/arrival/arrival_hand.gd")
const ArrivalKnob := preload("res://scenes/chapters/arrival/arrival_knob.gd")
const SCREEN_SHADER := preload("res://scenes/chapters/arrival/arrival_screen.gdshader")
# PLACEHOLDER sounds, generated by tools/arrival/make_placeholder_audio.py.
const SONG := preload("res://assets/audio/arrival/placeholder_heart_song.mp3")
const STATIC_SOUND := preload("res://assets/audio/arrival/placeholder_static.wav")
const CRY_SOUND := preload("res://assets/audio/arrival/placeholder_cry.wav")
const BREATH_SOUND := preload("res://assets/audio/arrival/placeholder_breath.wav")
const ZIP_SOUND := preload("res://assets/audio/arrival/placeholder_zip.wav")
const POP_SOUND := preload("res://assets/audio/arrival/placeholder_pop.wav")
const KEYS_SOUND := preload("res://assets/audio/arrival/placeholder_keys.wav")
const DOOR_SOUND := preload("res://assets/audio/arrival/placeholder_door.wav")

# Palette: DESIGN.md's ink and accent, a warm dark entry, a dawn for home.
const INK := Color("#F4EFE6")
const ACCENT := Color("#C4A574")
const BACKGROUND := Color("#1C1916")
const ENTRY_TOP := Color("#2B211B")
const ENTRY_BOTTOM := Color("#3D2D22")
const DOOR := Color("#5A3E2B")
const OUTSIDE := Color("#FBE3C8")
const BAG := Color("#5E6F64")
const STUFF: Array[Color] = [Color("#E9E1D3"), Color("#C98F86"), Color("#9DB4C8"), Color("#D8B35E")]
const SKIN := Color("#D9A88A")
const BABY_SKIN := Color("#EDBFA8")
const LIGHT := Color("#FFE8C2")
const MISSED := Color("#7E6878")
const DAWN_TOP := Color("#FBE3C8")
const DAWN_BOTTOM := Color("#E7A08F")
const MARGIN := 32.0

const BURST_TIME := 1.1  # The bag bursting open on the first try.
const SHUT_TIME := 0.8  # The bag squashed shut on the second.
const DOOR_OPEN_TIME := 2.2  # The door swinging open onto the light.
const TRAVEL := 2.0  # A light takes this long to fall to the hands.
const FILL_TIME := 4.0  # After the last note, before home.
const HOME_TIME := 16.0  # The quiet hold at the end.
const BREATH_PERIOD := 4.0  # Matches placeholder_breath.wav.
const VOLUME_EASE := 2.0  # How quickly loops follow their level (per second).

## Tests turn this off and move the clock themselves with advance().
var auto_advance := true

var beat := Beat.DOOR
## Seconds since the chapter opened (only while not paused).
var time := 0.0
## Seconds into the current beat.
var beat_time := 0.0

# Out the door.
var bag_tries := 0
var bag_shut := false
var keys_taken := false
var door_opened := false
var _bag_anim := 0.0  # Seconds since the last tap on the bag.
var _door_anim := 0.0

# Hear the cry.
var _cry := ArrivalCry.new()
var _knobs: Array = []
var _screen: ColorRect
var _waveform: Control

# Hold the hand.
var _hand := ArrivalHand.new()
var _song_started := false
var _song_time := -1.0
var _flash := 0.0
var _judgement: Label

var _paused := false
var _dim: ColorRect
var _static: AudioStreamPlayer
var _cry_player: AudioStreamPlayer
var _breath: AudioStreamPlayer
var _effect: AudioStreamPlayer
var _levels := {}
var _document: JavaScriptObject
var _visibility_callback: JavaScriptObject

@onready var _conductor: Node = %Conductor


func _ready() -> void:
	set_anchors_preset(PRESET_FULL_RECT)
	mouse_filter = MOUSE_FILTER_STOP
	_screen = ColorRect.new()
	_screen.name = "Screen"
	_screen.mouse_filter = MOUSE_FILTER_IGNORE
	var screen_material := ShaderMaterial.new()
	screen_material.shader = SCREEN_SHADER
	_screen.material = screen_material
	add_child(_screen)
	_waveform = Control.new()
	_waveform.name = "Waveform"
	_waveform.mouse_filter = MOUSE_FILTER_IGNORE
	_waveform.draw.connect(_draw_waveform)
	add_child(_waveform)
	for k in 2:
		var dial: Control = ArrivalKnob.new()
		dial.name = "Knob%d" % (k + 1)
		dial.set_value(_cry.knobs[k])
		dial.turned.connect(_on_knob_turned.bind(k))
		add_child(dial)
		_knobs.append(dial)
	_judgement = Label.new()
	_judgement.name = "Judgement"
	_judgement.mouse_filter = MOUSE_FILTER_IGNORE
	_judgement.add_theme_font_size_override("font_size", 36)
	_judgement.add_theme_color_override("font_color", INK)
	_judgement.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_judgement.modulate.a = 0.0
	add_child(_judgement)
	_dim = ColorRect.new()
	_dim.color = Color(0, 0, 0, 0.55)
	_dim.set_anchors_preset(PRESET_FULL_RECT)
	_dim.mouse_filter = MOUSE_FILTER_IGNORE
	_dim.visible = false
	add_child(_dim)
	_build_sound()
	_conductor.load_song(SONG)
	resized.connect(_layout)
	_layout()
	if OS.has_feature("web"):
		_bring_sound_back()
		# Hiding the tab pauses the chapter; Godot doesn't say so on the web.
		_document = JavaScriptBridge.get_interface("document")
		_visibility_callback = JavaScriptBridge.create_callback(_on_visibility_change)
		_document.addEventListener("visibilitychange", _visibility_callback)
	# Browser tests can start at a later beat (web_test_probe.gd).
	var start: String = get_tree().root.get_meta("arrival_start_beat", "")
	if start == "cry":
		_go(Beat.CRY)
	elif start == "hand":
		_go(Beat.HAND)
	_show_beat()


func _build_sound() -> void:
	_static = _player(STATIC_SOUND, "Static")
	_cry_player = _player(CRY_SOUND, "Cry")
	_breath = _player(BREATH_SOUND, "Breath")
	_effect = _player(null, "Effect")
	# The loops start silent and are faded in and out by their beat.
	for player in [_static, _cry_player, _breath]:
		_levels[player] = 0.0
		player.volume_db = linear_to_db(0.0001)
		player.play()


func _player(stream: AudioStream, node_name: String) -> AudioStreamPlayer:
	var player := AudioStreamPlayer.new()
	player.name = node_name
	player.stream = stream
	add_child(player)
	return player


func _play_effect(stream: AudioStream) -> void:
	_effect.stream = stream
	_effect.play()


func _exit_tree() -> void:
	if OS.has_feature("web"):
		JavaScriptBridge.eval("if (window.thresholdArrivalSound) window.thresholdArrivalSound.on = false;", true)
	if _document:
		_document.removeEventListener("visibilitychange", _visibility_callback)
		_document = null


# --- Layout

## The bag, the keys and the door, in screen units: the door beat's tap
## targets. Each is well over 44px on every screen.
func bag_rect() -> Rect2:
	var unit := minf(size.x, size.y)
	var w := maxf(unit * 0.5, 120.0)
	var h := maxf(unit * 0.28, 80.0)
	return Rect2(Vector2(size.x * 0.42 - w / 2.0, size.y * 0.78 - h / 2.0), Vector2(w, h))


func keys_rect() -> Rect2:
	var s := maxf(minf(size.x, size.y) * 0.18, 64.0)
	return Rect2(Vector2(size.x * 0.1, size.y * 0.42 - s / 2.0), Vector2(s, s))


func door_rect() -> Rect2:
	var w := maxf(minf(size.x * 0.24, size.y * 0.5), 88.0)
	return Rect2(Vector2(size.x * 0.92 - w, size.y * 0.1), Vector2(w, size.y * 0.82))


## Where the father's finger and the baby's hand meet, and the lights land.
func hands_centre() -> Vector2:
	return Vector2(size.x / 2.0, size.y * 0.56)


func _unit() -> float:
	return minf(size.x, size.y)


# The cry beat: knobs low on each side where the thumbs are when the phone is
# sideways, the screen between them; on an upright screen, under it (the
# Tuner's layout).
func _layout() -> void:
	var w := size.x
	var h := size.y
	if w <= 0.0 or h <= 0.0:
		return
	var knob_size := clampf(minf(w, h) * 0.3, 120.0, 260.0)
	var screen_rect: Rect2
	if w >= h:
		var side := knob_size + MARGIN * 2.0
		screen_rect = Rect2(side, MARGIN, w - side * 2.0, h - MARGIN * 2.0)
		_knobs[0].position = Vector2(MARGIN, h - MARGIN - knob_size - h * 0.12)
		_knobs[1].position = Vector2(w - MARGIN - knob_size, h - MARGIN - knob_size - h * 0.12)
	else:
		screen_rect = Rect2(MARGIN, MARGIN * 2.0, w - MARGIN * 2.0, (w - MARGIN * 2.0) * 1.1)
		var y := minf(screen_rect.end.y + MARGIN * 2.0, h - MARGIN - knob_size)
		_knobs[0].position = Vector2(MARGIN * 2.0, y)
		_knobs[1].position = Vector2(w - MARGIN * 2.0 - knob_size, y)
	for k: Control in _knobs:
		k.size = Vector2(knob_size, knob_size)
	var picture_h := screen_rect.size.y * 0.72
	_screen.position = screen_rect.position
	_screen.size = Vector2(screen_rect.size.x, picture_h)
	_waveform.position = screen_rect.position + Vector2(0.0, picture_h)
	_waveform.size = Vector2(screen_rect.size.x, screen_rect.size.y - picture_h)
	(_screen.material as ShaderMaterial).set_shader_parameter("aspect", _screen.size.x / maxf(_screen.size.y, 1.0))


func _show_beat() -> void:
	var tuning := beat == Beat.CRY
	_screen.visible = tuning
	_waveform.visible = tuning
	for k: Control in _knobs:
		k.visible = tuning


# --- The clock

func _process(delta: float) -> void:
	if auto_advance:
		advance(delta)


## Moves the chapter on by `delta` seconds (nothing moves while paused). In
## the hand beat the song's own clock leads; `delta` only moves the pictures.
func advance(delta: float) -> void:
	if _paused or beat == Beat.DONE:
		return
	time += delta
	beat_time += delta
	_flash = maxf(_flash - delta * 3.0, 0.0)
	_judgement.modulate.a = maxf(_judgement.modulate.a - delta * 1.6, 0.0)
	match beat:
		Beat.DOOR:
			_bag_anim += delta
			if door_opened:
				_door_anim += delta
				if _door_anim >= DOOR_OPEN_TIME:
					_go(Beat.CRY)
		Beat.CRY:
			_cry.advance(delta)
			for k: Control in _knobs:
				if _cry.stage != ArrivalCry.Stage.SEARCH:
					k.let_go()
			if _cry.stage == ArrivalCry.Stage.DONE:
				_go(Beat.HAND)
		Beat.HAND:
			_advance_hand()
		Beat.HOME:
			if beat_time >= HOME_TIME:
				_finish()
	_update_sound(delta)
	_update_screen()
	_place_judgement()
	queue_redraw()


func _advance_hand() -> void:
	if not _song_started:
		if _conductor.has_failed():
			queue_free()  # Leaves without a result; the House comes back.
			return
		if _conductor.is_ready():
			_song_started = true
			_conductor.start()
		return
	if _conductor.is_paused():
		return
	_song_time = _conductor.song_time()
	if _hand.mark_misses(_song_time) > 0:
		_show_judgement("Miss")
	if _song_time >= _hand.last_note() + FILL_TIME or _song_time >= ArrivalHand.SONG_LENGTH \
			or _conductor.has_song_ended():
		_conductor.stop()
		_go(Beat.HOME)


func _go(next: Beat) -> void:
	beat = next
	beat_time = 0.0
	_show_beat()
	match next:
		Beat.CRY:
			_cry = ArrivalCry.new()
			for k in 2:
				_knobs[k].set_value(_cry.knobs[k])


func _finish() -> void:
	beat = Beat.DONE
	for player in [_static, _cry_player, _breath]:
		player.stop()
	finished.emit()


# --- Taps

func _input(event: InputEvent) -> void:
	# One tap scheme: a touch, or a real mouse click. Touches also arrive as
	# emulated clicks, which are skipped so a tap isn't counted twice. Keys
	# and hovering do nothing.
	var pressed := false
	if event is InputEventScreenTouch:
		pressed = event.pressed
	elif event is InputEventMouseButton:
		pressed = event.pressed and event.button_index == MOUSE_BUTTON_LEFT \
				and event.device != InputEvent.DEVICE_ID_EMULATION
	if _paused:
		if pressed:
			get_viewport().set_input_as_handled()
			resume()
		elif event is InputEventMouse or event is InputEventScreenDrag:
			get_viewport().set_input_as_handled()
		return
	if beat == Beat.CRY:
		return  # The knobs take their own drags.
	if pressed:
		get_viewport().set_input_as_handled()
		tap_at(event.position)


## A tap at `point` (screen units). What it does depends on the beat.
func tap_at(point: Vector2) -> void:
	if _paused:
		return
	match beat:
		Beat.DOOR:
			_tap_door_beat(point)
		Beat.HAND:
			if _song_started:
				var said: String = _hand.judge(_conductor.tap_time())
				if said != "":
					_flash = 1.0
					_show_judgement(said)


func _tap_door_beat(point: Vector2) -> void:
	if not bag_shut:
		if bag_rect().grow(8.0).has_point(point):
			bag_tries += 1
			_bag_anim = 0.0
			if bag_tries == 1:
				_play_effect(POP_SOUND)  # Won't shut: it bursts open.
			else:
				bag_shut = true
				_play_effect(ZIP_SOUND)
	elif not keys_taken:
		if keys_rect().grow(8.0).has_point(point):
			keys_taken = true
			_play_effect(KEYS_SOUND)
	elif not door_opened:
		if door_rect().has_point(point):
			door_opened = true
			_door_anim = 0.0
			_play_effect(DOOR_SOUND)


## What can be tapped next in the door beat: "bag", "keys", "door" or "".
func next_door_target() -> String:
	if beat != Beat.DOOR:
		return ""
	if not bag_shut:
		return "bag"
	if not keys_taken:
		return "keys"
	if not door_opened:
		return "door"
	return ""


func _on_knob_turned(value: float, which: int) -> void:
	_cry.set_knob(which, value)
	_knobs[which].set_value(_cry.knobs[which])


func _show_judgement(text: String) -> void:
	_judgement.text = text
	_judgement.modulate.a = 1.0
	_place_judgement()


func _place_judgement() -> void:
	_judgement.size = Vector2.ZERO
	var below := hands_centre() + Vector2(0.0, _unit() * 0.22)
	_judgement.position = Vector2(below.x - _judgement.get_minimum_size().x / 2.0, below.y)
	_judgement.visible = beat == Beat.HAND


# --- Sound and the screen

func _update_sound(delta: float) -> void:
	var static_level := 0.0
	var cry_level := 0.0
	var breath_level := 0.0
	match beat:
		Beat.CRY:
			var s: float = _cry.strength()
			var clarity: float = _cry.clarity
			cry_level = lerpf(0.6 * s * s, 1.0, clarity)
			static_level = 0.5 * (1.0 - clarity) * (1.0 - 0.5 * s)
		Beat.HAND:
			cry_level = 0.0  # The cry fades as the heartbeat comes in.
		Beat.HOME:
			breath_level = 0.8
	_ease(_static, static_level, delta)
	_ease(_cry_player, cry_level, delta)
	_ease(_breath, breath_level, delta)


func _ease(player: AudioStreamPlayer, level: float, delta: float) -> void:
	var now: float = _levels[player]
	now = level if delta <= 0.0 else move_toward(now, level, VOLUME_EASE * delta)
	_levels[player] = now
	player.volume_db = linear_to_db(maxf(now, 0.0001))


func _update_screen() -> void:
	if beat != Beat.CRY:
		return
	var mat := _screen.material as ShaderMaterial
	mat.set_shader_parameter("clock", _cry.time)
	mat.set_shader_parameter("clarity", _cry.clarity)
	mat.set_shader_parameter("signal_level", _cry.strength())
	mat.set_shader_parameter("cry", _levels[_cry_player] * _wail(_cry.time))
	_waveform.queue_redraw()


# The cry's loudness at `t`: two wails every 4 s, like its sound file.
static func _wail(t: float) -> float:
	var at := fposmod(t, 4.0)
	for span: Vector2 in [Vector2(0.15, 1.5), Vector2(2.2, 1.65)]:
		var x := (at - span.x) / span.y
		if x >= 0.0 and x <= 1.0:
			return sin(PI * x)
	return 0.0


# The waveform: the only reading the knobs have (UX-DR17), drawn the Tuner's
# way. Noise when nothing is there; the cry's wails as much as comes through.
func _draw_waveform() -> void:
	if _waveform.size.x <= 0.0 or _waveform.size.y <= 0.0:
		return
	_waveform.draw_rect(Rect2(Vector2.ZERO, _waveform.size), Color(0.06, 0.055, 0.05))
	var colour := ACCENT.lerp(INK, _cry.strength() * 0.6)
	_waveform.draw_polyline(waveform_points(), colour, 3.0, true)


## The trace as drawn now, in the waveform's own space.
func waveform_points() -> PackedVector2Array:
	var w := _waveform.size.x
	var h := _waveform.size.y
	var s: float = _cry.strength()
	var t: float = _cry.time
	var noise := (1.0 - 0.85 * s) * (1.0 - _cry.clarity)
	var points := PackedVector2Array()
	var count := 120
	var rng := RandomNumberGenerator.new()
	rng.seed = int(t * 30.0)  # The noise changes 30 times a second, steady between.
	for k in count + 1:
		var x := float(k) / count
		var y := rng.randf_range(-1.0, 1.0) * noise
		y += s * cry_shape(x * 3.0 - t)
		points.append(Vector2(x * w, h / 2.0 - y * h * 0.38))
	return points


## The cry's shape at `phase` seconds along the trace, from -1 to 1: a fast
## ragged wave inside each wail.
static func cry_shape(phase: float) -> float:
	var wail := _wail(phase)
	return wail * (0.7 * sin(TAU * phase * 9.0) + 0.25 * sin(TAU * phase * 23.0 + 1.0))


# --- Drawing

func _draw() -> void:
	match beat:
		Beat.DOOR:
			_draw_door_beat()
		Beat.CRY:
			draw_rect(Rect2(Vector2.ZERO, size), BACKGROUND)
		Beat.HAND:
			_draw_hand_beat()
		Beat.HOME, Beat.DONE:
			_draw_home()


func _draw_gradient(top: Color, bottom: Color, alpha := 1.0) -> void:
	top.a *= alpha
	bottom.a *= alpha
	draw_polygon(PackedVector2Array([Vector2.ZERO, Vector2(size.x, 0), size, Vector2(0, size.y)]),
			PackedColorArray([top, top, bottom, bottom]))


func _capsule(a: Vector2, b: Vector2, r: float, colour: Color) -> void:
	draw_line(a, b, colour, r * 2.0, true)
	draw_circle(a, r, colour)
	draw_circle(b, r, colour)


# The soft ring the House uses for what can be tapped: the only hint here.
func _hint(rect: Rect2) -> void:
	var c := rect.get_center()
	var r := maxf(rect.size.x, rect.size.y) * 0.62
	var a := 0.35 + 0.25 * sin(beat_time * TAU / 1.6)
	draw_arc(c, r, 0.0, TAU, 64, Color(ACCENT, a), 3.0, true)


# PLACEHOLDER entry hall: the front door on the right, the keys in their
# basket on the left, the over-packed bag on the floor between.
func _draw_door_beat() -> void:
	_draw_gradient(ENTRY_TOP, ENTRY_BOTTOM)
	draw_rect(Rect2(0, size.y * 0.9, size.x, size.y * 0.1), Color("#2A1F18"))
	var door := door_rect()
	var open := ease(clampf(_door_anim / DOOR_OPEN_TIME, 0.0, 1.0), 0.5) if door_opened else 0.0
	# The morning outside, and the door swinging in onto it.
	draw_rect(door, OUTSIDE.lerp(Color.WHITE, 0.3))
	var leaf := Rect2(door.position, Vector2(door.size.x * (1.0 - 0.85 * open), door.size.y))
	draw_rect(leaf, DOOR)
	draw_rect(leaf.grow(-leaf.size.x * 0.12), DOOR.lightened(0.06), false, 3.0)
	draw_circle(Vector2(leaf.end.x - leaf.size.x * 0.16, door.get_center().y), maxf(leaf.size.x * 0.05, 3.0), ACCENT)
	if open > 0.0:
		# Light spills in and fills the screen.
		draw_rect(Rect2(Vector2.ZERO, size), Color(OUTSIDE, open * open))
	_draw_keys()
	_draw_bag()
	if open == 0.0:
		match next_door_target():
			"bag":
				_hint(bag_rect())
			"keys":
				_hint(keys_rect())
			"door":
				_hint(door)


func _draw_keys() -> void:
	var r := keys_rect()
	# A little basket on a shelf.
	draw_rect(Rect2(r.position.x - r.size.x * 0.2, r.end.y, r.size.x * 1.4, r.size.y * 0.12), Color("#4A3628"))
	var basket := Rect2(r.position + Vector2(0, r.size.y * 0.45), Vector2(r.size.x, r.size.y * 0.55))
	draw_rect(basket, Color("#8C6A48"))
	for k in 4:
		var y := basket.position.y + basket.size.y * (k + 1) / 5.0
		draw_line(Vector2(basket.position.x, y), Vector2(basket.end.x, y), Color("#6E5238"), 2.0)
	if keys_taken:
		return
	var ring := r.position + Vector2(r.size.x * 0.4, r.size.y * 0.32)
	var jiggle := sin(beat_time * 9.0) * 2.0 if next_door_target() == "keys" else 0.0
	draw_arc(ring + Vector2(jiggle, 0), r.size.x * 0.13, 0.0, TAU, 24, Color("#C9C9C9"), 3.0, true)
	_capsule(ring + Vector2(r.size.x * 0.1, r.size.y * 0.05), ring + Vector2(r.size.x * 0.38, r.size.y * 0.15), r.size.x * 0.05, Color("#BFBFBF"))
	_capsule(ring + Vector2(-r.size.x * 0.05, r.size.y * 0.12), ring + Vector2(r.size.x * 0.05, r.size.y * 0.4), r.size.x * 0.05, Color("#D4B062"))


# The bag: too full to shut. The first try bursts it open (her research, the
# baby things, the snacks, everything); the second squashes it shut.
func _draw_bag() -> void:
	var r := bag_rect()
	var squash := 0.0
	var burst := 0.0
	if bag_shut:
		squash = 0.12 * sin(PI * clampf(_bag_anim / SHUT_TIME, 0.0, 1.0))
	elif bag_tries == 1:
		burst = clampf(_bag_anim / BURST_TIME, 0.0, 1.0)
	var body := Rect2(r.position + Vector2(-r.size.x * squash * 0.5, r.size.y * squash),
			Vector2(r.size.x * (1.0 + squash), r.size.y * (1.0 - squash)))
	if not bag_shut:
		# Things sticking out of the top; on the burst they fly up and land
		# back, sticking out further.
		for k in STUFF.size():
			var x := body.position.x + body.size.x * (0.18 + 0.21 * k)
			var lift := body.size.y * (0.35 + 0.1 * (k % 2))
			if bag_tries == 1:
				var hop := sin(PI * burst) * body.size.y * (0.9 + 0.3 * k)
				lift += hop + body.size.y * 0.15 * burst
			var item := Rect2(Vector2(x - body.size.x * 0.09, body.position.y - lift),
					Vector2(body.size.x * 0.18, lift + body.size.y * 0.2))
			draw_rect(item, STUFF[k])
	draw_rect(body, BAG)
	# Handles and the zip line.
	draw_arc(Vector2(body.get_center().x, body.position.y), body.size.x * 0.22, PI, TAU, 24, BAG.darkened(0.3), 6.0, true)
	var zip_to := 1.0 if bag_shut else (0.45 * (1.0 - burst) if bag_tries == 1 else 0.0)
	var y := body.position.y + 4.0
	draw_line(Vector2(body.position.x, y), Vector2(body.end.x, y), BAG.darkened(0.4), 3.0)
	if zip_to > 0.0:
		draw_line(Vector2(body.position.x, y), Vector2(body.position.x + body.size.x * zip_to, y), ACCENT, 4.0)


# The hands: the father's from below, one finger out (the hand from the
# Loss's run), and the baby's small hand from above, closing round it as the
# beat goes on. PLACEHOLDER shapes; no baby model (FR30).
func _draw_hand_beat() -> void:
	var t := _song_time if _song_time >= 0.0 else 0.0
	var first := ArrivalHand.FIRST_NOTE
	var grip := clampf((t - first) / (_hand.last_note() - first), 0.0, 1.0)
	var warm := grip * 0.6
	_draw_gradient(BACKGROUND.lerp(Color("#3A2A22"), warm), Color("#2A201B").lerp(Color("#6E4A3A"), warm))
	var c := hands_centre()
	var u := _unit()
	# A soft light round where the hands meet, brighter on each hit.
	for k in range(6, 0, -1):
		draw_circle(c, u * (0.06 + k * 0.05), Color(LIGHT, 0.03 + 0.02 * grip + 0.03 * _flash))
	# The father's hand, from the bottom right: wrist, palm, three fingers
	# curled under, the index finger out to where the hands meet.
	var palm := c + Vector2(u * 0.2, u * 0.2)
	_capsule(palm + Vector2(u * 0.25, u * 0.35), palm, u * 0.09, SKIN.darkened(0.08))
	draw_circle(palm, u * 0.11, SKIN)
	for k in 3:
		var knuckle := palm + Vector2(-u * 0.1 + k * u * 0.045, -u * 0.02 + k * u * 0.05)
		_capsule(knuckle, knuckle + Vector2(-u * 0.015, u * 0.04), u * 0.028, SKIN.darkened(0.06))
	_capsule(palm + Vector2(u * 0.05, -u * 0.09), palm + Vector2(-u * 0.02, -u * 0.13), u * 0.03, SKIN.darkened(0.03))  # thumb
	_capsule(palm + Vector2(-u * 0.07, -u * 0.07), c + Vector2(u * 0.01, u * 0.01), u * 0.03, SKIN)
	# The baby's hand, from the top left; its fingers curl round the
	# father's fingertip as the beat goes on.
	var baby := c + Vector2(-u * 0.11, -u * 0.09)
	_capsule(baby + Vector2(-u * 0.2, -u * 0.22), baby, u * 0.045, BABY_SKIN.darkened(0.05))
	draw_circle(baby, u * 0.055, BABY_SKIN)
	for k in 4:
		var base := baby + Vector2.from_angle(deg_to_rad(-20.0 + k * 28.0)) * u * 0.045
		var open_tip := base + Vector2.from_angle(deg_to_rad(-35.0 + k * 22.0)) * u * 0.06
		var closed_tip := c + Vector2(u * (0.0 + 0.012 * k), u * (0.035 - 0.012 * k))
		_capsule(base, open_tip.lerp(closed_tip, grip), u * 0.014, BABY_SKIN.lightened(0.04))
	_capsule(baby + Vector2(-u * 0.01, u * 0.05), (baby + Vector2(u * 0.02, u * 0.1)).lerp(c + Vector2(-u * 0.02, u * 0.03), grip),
			u * 0.015, BABY_SKIN)  # thumb
	if _flash > 0.0:
		draw_arc(c, u * (0.05 + 0.08 * (1.0 - _flash)), 0.0, TAU, 48, Color(LIGHT, _flash * 0.7), 3.0, true)
	_draw_lights(c, u, t)
	# After the last note the light fills the screen, on towards home.
	if t > _hand.last_note():
		var fill := clampf((t - _hand.last_note()) / FILL_TIME, 0.0, 1.0)
		draw_circle(c, lerpf(u * 0.05, size.length() * 1.1, ease(fill, 0.4)), Color(DAWN_TOP, fill))


# Small lights fall to the hands and reach them on the beat as the player
# hears it, the Partner's way, with a faint target where the hands meet.
func _draw_lights(c: Vector2, u: float, t: float) -> void:
	var r := u * 0.025
	var soon := 0.0
	var next: int = _hand.next_note()
	if next < ArrivalHand.NOTE_COUNT:
		soon = clampf(1.0 - _hand.until(next, t) / 0.5, 0.0, 1.0)
	draw_circle(c, r, Color(LIGHT, 0.18 + 0.17 * soon))
	for i in range(maxi(next - 3, 0), ArrivalHand.NOTE_COUNT):
		var until: float = _hand.until(i, t)
		if until > TRAVEL:
			break
		if _hand.judged[i] == ArrivalHand.Judged.HIT:
			continue
		var pos := Vector2(c.x, lerpf(-r, c.y, 1.0 - until / TRAVEL))
		var colour := Color(LIGHT, clampf((TRAVEL - until) / 0.3, 0.0, 1.0))
		if _hand.judged[i] == ArrivalHand.Judged.MISSED:
			colour = Color(MISSED, clampf(0.6 + until * 1.5, 0.0, 0.6))
		if colour.a <= 0.0:
			continue
		draw_circle(pos, r * 2.0, Color(colour, colour.a * 0.2))
		draw_circle(pos, r, colour)


# Home: dawn, and the small light, breathing. PROPOSED; the last House shot
# (the nursery at dawn, the monitor's light) is the House's.
func _draw_home() -> void:
	draw_rect(Rect2(Vector2.ZERO, size), DAWN_TOP)
	_draw_gradient(DAWN_TOP, DAWN_BOTTOM, clampf(beat_time / 3.0, 0.0, 1.0))
	var c := Vector2(size.x / 2.0, size.y * 0.5)
	var u := _unit()
	var breath := 0.5 + 0.5 * sin(beat_time * TAU / BREATH_PERIOD)
	for k in range(6, 0, -1):
		draw_circle(c, u * (0.03 + k * 0.025) * (1.0 + 0.15 * breath), Color(1.0, 0.97, 0.9, 0.08))
	draw_circle(c, u * 0.025, Color(1.0, 0.98, 0.92))


# --- Pause: hiding the tab stops the chapter, its sound and its clocks, and
# the next tap brings them back. Never saves.

func pause() -> void:
	if _paused or beat == Beat.DONE:
		return
	_paused = true
	_dim.visible = true
	for k: Control in _knobs:
		k.let_go()
	for player in [_static, _cry_player, _breath, _effect]:
		player.stream_paused = true
	_conductor.pause()  # Native only; the web suspends the song itself.


func resume() -> void:
	if not _paused:
		return
	_paused = false
	_dim.visible = false
	for player in [_static, _cry_player, _breath, _effect]:
		player.stream_paused = false
	_conductor.resume()  # Native only; the web resumes in its own tap handler.


func is_paused() -> bool:
	return _paused


func _notification(what: int) -> void:
	# Native builds; the web says so through visibilitychange (see _ready).
	if what in [NOTIFICATION_APPLICATION_FOCUS_OUT, NOTIFICATION_APPLICATION_PAUSED] \
			and not OS.has_feature("web"):
		pause()


func _on_visibility_change(_args: Array) -> void:
	if _document and _document.hidden:
		pause()


# After the tab has been away, Safari can leave the page's sound stopped (the
# Loss found this, Dan, 2026-10-27). The tap that resumes restarts every
# audio context the page made, inside the browser's own tap handler, which
# is the only place a phone lets sound start. (A copy of the Tuner's.)
func _bring_sound_back() -> void:
	JavaScriptBridge.eval("""
		if (!window.thresholdArrivalSound) {
			const back = window.thresholdArrivalSound = { on: false, away: false };
			document.addEventListener('visibilitychange', () => {
				if (document.hidden) back.away = true;
			});
			const tapped = () => {
				if (!back.on || document.hidden) return;
				for (const ctx of window.thresholdAudioContexts || []) {
					if (ctx.state === 'closed') continue;
					if (ctx.state !== 'running') {
						ctx.resume();
					} else if (back.away) {
						ctx.suspend();
						ctx.resume();
					}
				}
				back.away = false;
			};
			for (const type of ['touchend', 'mouseup', 'keydown']) {
				window.addEventListener(type, tapped, true);
			}
		}
		window.thresholdArrivalSound.on = true;
		window.thresholdArrivalSound.away = false;
	""", true)


# --- For tests, the playtest overlay and the browser tests.

func cry() -> RefCounted:
	return _cry


func hand() -> RefCounted:
	return _hand


func knob(which: int) -> Control:
	return _knobs[which]


func sound_level(which: String) -> float:
	match which:
		"static":
			return _levels[_static]
		"cry":
			return _levels[_cry_player]
		"breath":
			return _levels[_breath]
	return 0.0


func is_sound_playing() -> bool:
	return _static.playing and not _static.stream_paused


## Seconds into the chapter, for the playtest overlay's clock.
func playtest_time() -> float:
	return time


func probe_state() -> Dictionary:
	var centres := []
	for k: Control in _knobs:
		var c := k.get_global_rect().get_center()
		centres.append({"x": c.x, "y": c.y, "r": k.radius()})
	var targets := {}
	for entry in [["bag", bag_rect()], ["keys", keys_rect()], ["door", door_rect()]]:
		var c: Vector2 = (entry[1] as Rect2).get_center()
		targets[entry[0]] = {"x": c.x, "y": c.y}
	return {
		"beat": Beat.keys()[beat],
		"time": time,
		"next": next_door_target(),
		"targets": targets,
		"bagTries": bag_tries,
		"cryStage": ArrivalCry.Stage.keys()[_cry.stage],
		"knobs": [_cry.knobs.x, _cry.knobs.y],
		"knobCentres": centres,
		"strength": _cry.strength(),
		"clarity": _cry.clarity,
		"songTime": _song_time,
		"hits": _hand.hits(),
		"misses": _hand.misses(),
		"judgement": _judgement.text if _judgement.modulate.a > 0.0 else "",
		"clock": "browser" if _conductor.uses_browser_clock else "Godot",
		"paused": _paused,
		"sound": is_sound_playing(),
	}
