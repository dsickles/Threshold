extends Control
## The Mourner, rough M2 playable (DAS-136). Month 17: the spare room, seen
## from its doorway, still full of Leo's old life. The player picks things up
## and drags them (a ghost follows the finger) to their one place: kept,
## stored or given away. Under the boxes is the memory box, with the first
## test and the onesie; the music thins, and it goes, closed, to the high
## shelf. The room is empty, the light comes up, then the baby monitor and the
## crib come in, the last placement. Beats: docs/design/story-beats.md §7
## (one angle, put to Dan). No words.
##
## The rules are mourner_room.gd. Everything drawn and every sound here is a
## PLACEHOLDER (shapes drawn in code; tools/mourner/make_placeholder_audio.py).
##
## The chapter only reports that it finished (no Stoic/Vulnerable answer),
## and never touches the House or saved state: the chapter runner and the
## core table do that. Leaving part-way gives no result, so the next visit
## starts again with the room full. Hiding the tab pauses everything until
## the next tap, and never saves.

signal finished

const MournerRoom := preload("res://scenes/chapters/mourner/mourner_room.gd")
const Stage := MournerRoom.Stage
# PLACEHOLDER sounds, generated by tools/mourner/make_placeholder_audio.py.
const SCORE_FULL := preload("res://assets/audio/mourner/placeholder_score_full.wav")
const SCORE_THIN := preload("res://assets/audio/mourner/placeholder_score_thin.wav")
const PLACE_SOUND := preload("res://assets/audio/mourner/placeholder_place.wav")
const BAG_SOUND := preload("res://assets/audio/mourner/placeholder_bag.wav")

const BACKGROUND := Color("#1C1916")
const ACCENT := Color("#C4A574")
const INK := Color("#F4EFE6")
## How long a thing takes to slide back when it can't stay, then to shake
## where it landed.
const SLIDE_TIME := 0.3
const SHAKE_TIME := 0.3
const BACK_TIME := SLIDE_TIME + SHAKE_TIME
## How long a placed thing takes to settle.
const SETTLE_TIME := 0.3
## How quickly each layer of the score follows its level (per second).
const VOLUME_EASE := 0.5

## Tests turn this off and move the clock themselves with advance().
var auto_advance := true

var _room := MournerRoom.new()
var _scale := 1.0
var _offset := Vector2.ZERO
var _held: StringName = &""
## From the finger to the held thing's top-left corner, in room units.
var _grab := Vector2.ZERO
## The finger, in room units.
var _finger := Vector2.ZERO
## Things sliding back: id to {"from": top-left where it was let go, "t": seconds}.
var _going_back := {}
## Things settling into place: id to seconds since placed.
var _settling := {}
var _dim: ColorRect
var _paused := false
var _finished := false
var _full: AudioStreamPlayer
var _thin: AudioStreamPlayer
var _place: AudioStreamPlayer
var _bag: AudioStreamPlayer
var _levels := {}
var _document: JavaScriptObject
var _visibility_callback: JavaScriptObject


func _ready() -> void:
	set_anchors_preset(PRESET_FULL_RECT)
	mouse_filter = MOUSE_FILTER_STOP
	focus_mode = FOCUS_NONE
	_dim = ColorRect.new()
	_dim.name = "Dim"
	_dim.color = Color(0, 0, 0, 0.55)
	_dim.set_anchors_preset(PRESET_FULL_RECT)
	_dim.mouse_filter = MOUSE_FILTER_IGNORE
	_dim.visible = false
	add_child(_dim)
	_build_sound()
	resized.connect(_layout)
	_layout()
	if OS.has_feature("web"):
		_bring_sound_back()
		# Hiding the tab pauses the chapter; Godot doesn't say so on the web.
		_document = JavaScriptBridge.get_interface("document")
		_visibility_callback = JavaScriptBridge.create_callback(_on_visibility_change)
		_document.addEventListener("visibilitychange", _visibility_callback)
	_update_sound(0.0)


func _build_sound() -> void:
	_full = _player(SCORE_FULL, "ScoreFull")
	_thin = _player(SCORE_THIN, "ScoreThin")
	_place = _player(PLACE_SOUND, "Place")
	_bag = _player(BAG_SOUND, "Bag")
	# Both layers start together so they stay in step; the full one fades out
	# at the memory box and back in with the light.
	for player in [_full, _thin]:
		_levels[player] = 0.0
		player.volume_db = linear_to_db(0.0001)
		player.play()


func _player(stream: AudioStream, node_name: String) -> AudioStreamPlayer:
	var player := AudioStreamPlayer.new()
	player.name = node_name
	player.stream = stream
	add_child(player)
	return player


func _exit_tree() -> void:
	if OS.has_feature("web"):
		JavaScriptBridge.eval("if (window.thresholdMournerSound) window.thresholdMournerSound.on = false;", true)
	if _document:
		_document.removeEventListener("visibilitychange", _visibility_callback)
		_document = null


# The room is drawn as large as fits, in the middle of the screen.
func _layout() -> void:
	if size.x <= 0.0 or size.y <= 0.0:
		return
	_scale = minf(size.x / MournerRoom.ROOM_SIZE.x, size.y / MournerRoom.ROOM_SIZE.y)
	_offset = (size - MournerRoom.ROOM_SIZE * _scale) / 2.0
	queue_redraw()


func _process(delta: float) -> void:
	if auto_advance:
		advance(delta)


## Moves the chapter's clock on by `delta` seconds (nothing moves while paused).
func advance(delta: float) -> void:
	if _paused or _finished:
		return
	var before: int = _room.stage
	_room.advance(delta)
	for id: StringName in _going_back.keys():
		_going_back[id].t += delta
		if _going_back[id].t >= BACK_TIME:
			_going_back.erase(id)
	for id: StringName in _settling.keys():
		_settling[id] += delta
		if _settling[id] >= SETTLE_TIME:
			_settling.erase(id)
	if before != _room.stage and _room.stage == Stage.DONE:
		_finished = true
		_held = &""
		for player in [_full, _thin]:
			player.stop()
		finished.emit()
		return
	_update_sound(delta)
	queue_redraw()


# --- Picking up and putting down. One finger or the mouse; touches arrive
# as clicks (the one tap scheme). Nothing happens on hover or on keys.

func _gui_input(event: InputEvent) -> void:
	if _paused or _finished:
		return
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		accept_event()
		if event.pressed:
			_press(_to_room(event.position))
		else:
			_release(_to_room(event.position))
	elif event is InputEventMouseMotion and _held != &"" \
			and event.button_mask & MOUSE_BUTTON_MASK_LEFT:
		accept_event()
		_finger = _to_room(event.position)
		queue_redraw()


func _press(at: Vector2) -> void:
	var id: StringName = _room.thing_at(at)
	if id == &"" or id in _going_back:
		return
	_held = id
	_finger = at
	_grab = _room.rect_of(id).position - at
	queue_redraw()


func _release(at: Vector2) -> void:
	if _held == &"":
		return
	var id := _held
	_held = &""
	_finger = at
	var ghost := ghost_rect_room(id)
	if _room.drop(id, ghost.get_center()):
		_settling[id] = 0.0
		var to: StringName = MournerRoom.thing(id).to
		(_bag if to in [&"storage", &"giveaway"] else _place).play()
	else:
		# It can't stay there: it slides back and shakes (more than colour).
		_going_back[id] = {"from": ghost.position, "t": 0.0}
	queue_redraw()


func _to_room(point: Vector2) -> Vector2:
	return (point - _offset) / _scale


func _to_screen(r: Rect2) -> Rect2:
	return Rect2(_offset + r.position * _scale, r.size * _scale)


## The held thing's ghost, in room units.
func ghost_rect_room(id: StringName) -> Rect2:
	return Rect2(_finger + _grab, _room.rect_of(id).size)


# --- Sound.

func _update_sound(delta: float) -> void:
	var full := 1.0
	match _room.stage:
		Stage.MEMORY_BOX:
			full = 0.0  # The music thins.
		Stage.LIGHT, Stage.MONITOR, Stage.CRIB, Stage.ENDING:
			full = 0.7
	var fade_in := minf(_room.time / 2.0, 1.0)
	_ease(_full, full * fade_in, delta)
	_ease(_thin, fade_in, delta)


func _ease(player: AudioStreamPlayer, level: float, delta: float) -> void:
	var now: float = _levels[player]
	now = level if delta <= 0.0 else move_toward(now, level, VOLUME_EASE * delta)
	_levels[player] = now
	player.volume_db = linear_to_db(maxf(now, 0.0001))


# --- Drawing. Everything is a PLACEHOLDER shape, in room units.

func _draw() -> void:
	draw_rect(Rect2(Vector2.ZERO, size), BACKGROUND)
	draw_set_transform(_offset, 0.0, Vector2(_scale, _scale))
	var light: float = _room.light
	var room := MournerRoom.ROOM_SIZE
	var wall := Color("#3A332C").lerp(Color("#D9CDB8"), light)
	var floor_colour := Color("#2E241B").lerp(Color("#A37E56"), light)
	draw_rect(Rect2(0, 0, room.x, MournerRoom.FLOOR_Y), wall)
	draw_rect(Rect2(0, MournerRoom.FLOOR_Y, room.x, room.y - MournerRoom.FLOOR_Y), floor_colour)
	for x in [150.0, 960.0]:
		_draw_window(Rect2(x, 70, 220, 230), light)
	# The high shelf and the small one for the monitor.
	draw_rect(Rect2(550, 188, 220, 12), Color("#6B5440").lerp(Color("#9C7A57"), light))
	draw_rect(Rect2(415, 458, 160, 10), Color("#6B5440").lerp(Color("#9C7A57"), light))
	_draw_chair(light)
	_draw_tote(MournerRoom.PLACES[&"storage"], light, &"storage")
	_draw_bag(MournerRoom.PLACES[&"giveaway"], light, &"giveaway")
	var hint: StringName = _room.hint()
	if hint != &"":
		var pulse := 0.5 + 0.5 * sin(_room.time * 4.0)
		_draw_outline(MournerRoom.PLACES[MournerRoom.thing(hint).to], ACCENT, 3.0 + 3.0 * pulse)
	if _held != &"":
		_draw_outline(MournerRoom.PLACES[MournerRoom.thing(_held).to], Color(ACCENT, 0.6), 3.0)
	for id: StringName in _room.placed:
		var to: StringName = MournerRoom.thing(id).to
		if to in [&"storage", &"giveaway"]:
			continue  # Inside the tote or the bag.
		var r: Rect2 = _room.rect_of(id)
		if id in _settling:
			var k: float = 1.0 + 0.06 * (1.0 - _settling[id] / SETTLE_TIME)
			r = r.grow_individual(r.size.x * (k - 1.0) / 2.0, r.size.y * (k - 1.0), r.size.x * (k - 1.0) / 2.0, 0.0)
		_draw_thing(id, r, light, 1.0, true)
	for id: StringName in _room.visible_unplaced():
		if id == _held:
			_draw_thing(id, _room.rect_of(id), light, 0.25, false)  # Where it came from.
			continue
		var r: Rect2 = _room.rect_of(id)
		if id in _going_back:
			r.position = back_position(id)
		elif id == hint:
			r.position.y -= 6.0 * absf(sin(_room.time * 3.0))
		_draw_thing(id, r, light, 1.0, false)
	if _held != &"":
		# The ghost, under the finger.
		_draw_thing(_held, ghost_rect_room(_held), light, 0.75, false)
	# The room is dark when the door opens and lightens as it empties.
	draw_rect(Rect2(Vector2.ZERO, room), Color(0.05, 0.04, 0.03, 0.55 * (1.0 - light)))
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


## Where a thing going back is now: sliding home, then a small shake there
## that dies away.
func back_position(id: StringName) -> Vector2:
	var home: Vector2 = _room.rect_of(id).position
	var going: Dictionary = _going_back[id]
	var slid: float = clampf(going.t / SLIDE_TIME, 0.0, 1.0)
	var at: Vector2 = going.from.lerp(home, smoothstep(0.0, 1.0, slid))
	if going.t > SLIDE_TIME:
		var shaken: float = clampf((going.t - SLIDE_TIME) / SHAKE_TIME, 0.0, 1.0)
		at.x += sin((going.t - SLIDE_TIME) * 50.0) * 12.0 * (1.0 - shaken)
	return at


func _draw_outline(r: Rect2, colour: Color, width: float) -> void:
	# Dashed, so the place reads by its shape, not only by its colour.
	var corners := [r.position, Vector2(r.end.x, r.position.y), r.end, Vector2(r.position.x, r.end.y), r.position]
	for k in 4:
		draw_dashed_line(corners[k], corners[k + 1], colour, width, 14.0)


func _draw_window(r: Rect2, light: float) -> void:
	draw_rect(r.grow(10), Color("#5A4A3A").lerp(Color("#EDE4D3"), light))
	draw_rect(r, Color("#1E2A3A").lerp(Color("#F6E7C1"), light))
	draw_line(Vector2(r.get_center().x, r.position.y), Vector2(r.get_center().x, r.end.y), Color("#5A4A3A").lerp(Color("#EDE4D3"), light), 6.0)
	draw_line(Vector2(r.position.x, r.get_center().y), Vector2(r.end.x, r.get_center().y), Color("#5A4A3A").lerp(Color("#EDE4D3"), light), 6.0)
	if light > 0.4:
		# Good light: a pale patch on the floor below.
		var a := (light - 0.4) / 0.6
		var patch := PackedVector2Array([
			Vector2(r.position.x, MournerRoom.FLOOR_Y), Vector2(r.end.x, MournerRoom.FLOOR_Y),
			Vector2(r.end.x + 60, 700), Vector2(r.position.x - 20, 700)])
		draw_colored_polygon(patch, Color(1.0, 0.94, 0.78, 0.18 * a))


# Leo's lounge chair stays (a proposal): leather, reclining, with its ottoman.
func _draw_chair(light: float) -> void:
	var leather := Color("#3B2416").lerp(Color("#7A4A2C"), light)
	draw_rect(Rect2(575, 260, 150, 150), leather)            # The back.
	draw_rect(Rect2(560, 390, 180, 70), leather.lightened(0.08))  # The seat.
	draw_rect(Rect2(570, 460, 12, 50), Color("#222222"))
	draw_rect(Rect2(718, 460, 12, 50), Color("#222222"))


func _draw_tote(r: Rect2, light: float, place: StringName) -> void:
	var body := Rect2(r.position + Vector2(10, 40), r.size - Vector2(20, 40))
	_draw_inside(r, place, light)
	draw_rect(body, Color("#3E4A57").lerp(Color("#8FA3B5"), light))
	draw_rect(Rect2(body.position - Vector2(6, 0), Vector2(body.size.x + 12, 14)), Color("#33404C").lerp(Color("#7B8FA1"), light))


func _draw_bag(r: Rect2, light: float, place: StringName) -> void:
	_draw_inside(r, place, light)
	var cloth := Color("#5C5040").lerp(Color("#CDBB98"), light)
	var bag := PackedVector2Array([
		r.position + Vector2(30, 50), r.position + Vector2(r.size.x - 30, 50),
		r.end - Vector2(10, 0), Vector2(r.position.x + 10, r.end.y)])
	draw_colored_polygon(bag, cloth)
	draw_arc(r.position + Vector2(r.size.x / 2.0, 50), 40.0, PI, TAU, 16, cloth.darkened(0.2), 8.0)


# What has gone into the tote or the bag shows over its top edge.
func _draw_inside(r: Rect2, place: StringName, light: float) -> void:
	var count := 0
	for id: StringName in _room.placed:
		if MournerRoom.thing(id).to != place:
			continue
		var peek := Rect2(r.position + Vector2(30 + count * 55, 20 - count * 6), Vector2(90, 60))
		_draw_thing(id, peek, light, 1.0, true)
		count += 1


func _draw_thing(id: StringName, r: Rect2, light: float, alpha: float, placed: bool) -> void:
	var lit := lerpf(0.55, 1.0, light)
	var card := Color(0.62 * lit, 0.47 * lit, 0.3 * lit, alpha)
	match id:
		&"poster":
			draw_rect(r, Color(0.12, 0.1, 0.14, alpha))
			draw_rect(r.grow(-10), Color(0.5 * lit, 0.15 * lit, 0.35 * lit, alpha))
			draw_circle(r.get_center() - Vector2(0, r.size.y * 0.12), r.size.x * 0.25, Color(0.95 * lit, 0.75 * lit, 0.2 * lit, alpha))
			var zig := PackedVector2Array()
			for k in 6:
				zig.append(Vector2(r.position.x + 15 + k * (r.size.x - 30) / 5.0, r.end.y - 40 + (15 if k % 2 else -15)))
			draw_polyline(zig, Color(INK, alpha), 4.0)
		&"guitar":
			var wood := Color(0.75 * lit, 0.45 * lit, 0.2 * lit, alpha)
			var mid := r.get_center().x
			draw_rect(Rect2(mid - 8, r.position.y + 10, 16, r.size.y * 0.5), Color(0.3 * lit, 0.2 * lit, 0.12 * lit, alpha))
			draw_rect(Rect2(mid - 14, r.position.y, 28, 30), Color(0.2 * lit, 0.14 * lit, 0.1 * lit, alpha))
			draw_circle(Vector2(mid, r.position.y + r.size.y * 0.62), r.size.x * 0.28, wood)
			draw_circle(Vector2(mid, r.position.y + r.size.y * 0.8), r.size.x * 0.36, wood)
			draw_circle(Vector2(mid, r.position.y + r.size.y * 0.68), r.size.x * 0.09, Color(0.1, 0.08, 0.06, alpha))
			if not placed:  # Its stand.
				draw_line(Vector2(mid, r.end.y - 30), Vector2(mid - 40, r.end.y), Color(0.15, 0.15, 0.15, alpha), 5.0)
				draw_line(Vector2(mid, r.end.y - 30), Vector2(mid + 40, r.end.y), Color(0.15, 0.15, 0.15, alpha), 5.0)
		&"games_box", &"tshirts_box", &"stuff_box":
			draw_rect(r, card)
			draw_rect(Rect2(r.position.x, r.position.y + r.size.y * 0.18, r.size.x, 8), Color(card.darkened(0.25), alpha))
			draw_rect(Rect2(r.get_center().x - 10, r.position.y, 20, r.size.y * 0.25), Color(0.85 * lit, 0.8 * lit, 0.6 * lit, alpha))
			_draw_box_mark(id, r, lit, alpha)
		&"memory_box":
			# A shoebox, shut; a corner of something soft shows under the lid
			# (the onesie). Kept closed (a proposal).
			var body := Rect2(r.position + Vector2(10, r.size.y * 0.35), Vector2(r.size.x - 20, r.size.y * 0.55))
			draw_rect(body, Color(0.55 * lit, 0.6 * lit, 0.68 * lit, alpha))
			draw_colored_polygon(PackedVector2Array([
				body.position + Vector2(body.size.x * 0.6, 0), body.position + Vector2(body.size.x * 0.75, 0),
				body.position + Vector2(body.size.x * 0.7, 14)]), Color(0.98 * lit, 0.95 * lit, 0.9 * lit, alpha))
			draw_rect(Rect2(body.position - Vector2(6, 16), Vector2(body.size.x + 12, 18)), Color(0.45 * lit, 0.5 * lit, 0.6 * lit, alpha))
		&"monitor":
			var unit := Rect2(r.position + Vector2(r.size.x * 0.3, r.size.y * 0.35), Vector2(r.size.x * 0.4, r.size.y * 0.55))
			draw_rect(unit, Color(0.92 * lit, 0.92 * lit, 0.9 * lit, alpha))
			draw_line(unit.position + Vector2(unit.size.x * 0.75, 0), unit.position + Vector2(unit.size.x * 0.75, -30), Color(0.85 * lit, 0.85 * lit, 0.85 * lit, alpha), 6.0)
			draw_circle(unit.position + Vector2(unit.size.x / 2.0, 20), 7.0, Color(0.45, 0.85, 0.5, alpha) if placed else Color(0.4, 0.4, 0.4, alpha))
		&"crib":
			var wood := Color(0.86 * lit, 0.76 * lit, 0.58 * lit, alpha)
			var top := r.position.y + 40
			draw_rect(Rect2(r.position.x, top, 16, r.size.y - 40), wood)
			draw_rect(Rect2(r.end.x - 16, top, 16, r.size.y - 40), wood)
			draw_rect(Rect2(r.position.x, top, r.size.x, 14), wood)
			draw_rect(Rect2(r.position.x, r.end.y - 60, r.size.x, 18), wood)
			for k in range(1, 12):
				var x := r.position.x + k * r.size.x / 12.0
				draw_line(Vector2(x, top), Vector2(x, r.end.y - 50), wood, 5.0)


# The mark drawn on each of Leo's boxes: what is inside, as a picture
# (PLACEHOLDER: games, band T-shirts, single-guy stuff).
func _draw_box_mark(id: StringName, r: Rect2, lit: float, alpha: float) -> void:
	var ink := Color(0.2 * lit, 0.15 * lit, 0.1 * lit, alpha)
	var c := r.get_center() + Vector2(0, r.size.y * 0.15)
	match id:
		&"games_box":
			draw_rect(Rect2(c - Vector2(36, 16), Vector2(72, 32)), ink)
			draw_circle(c + Vector2(-18, 0), 6.0, Color(card_colour(lit), alpha))
			draw_circle(c + Vector2(18, 0), 6.0, Color(card_colour(lit), alpha))
		&"tshirts_box":
			draw_colored_polygon(PackedVector2Array([
				c + Vector2(-34, -24), c + Vector2(-12, -28), c + Vector2(12, -28), c + Vector2(34, -24),
				c + Vector2(40, -8), c + Vector2(24, -4), c + Vector2(24, 26), c + Vector2(-24, 26),
				c + Vector2(-24, -4), c + Vector2(-40, -8)]), ink)
		&"stuff_box":
			draw_colored_polygon(PackedVector2Array([
				c + Vector2(-10, -30), c + Vector2(10, -30), c + Vector2(18, 14),
				c + Vector2(-18, 14)]), ink)
			draw_rect(Rect2(c + Vector2(-20, 14), Vector2(40, 14)), ink)


static func card_colour(lit: float) -> Color:
	return Color(0.62 * lit, 0.47 * lit, 0.3 * lit)


# --- Pause: hiding the tab stops the chapter, the sound and the clocks, and
# the next tap brings them back. Never saves.

func _input(event: InputEvent) -> void:
	if not _paused:
		return
	var pressed := false
	if event is InputEventScreenTouch:
		pressed = event.pressed
	elif event is InputEventMouseButton:
		pressed = event.pressed and event.button_index == MOUSE_BUTTON_LEFT
	if pressed:
		get_viewport().set_input_as_handled()
		resume()
	elif event is InputEventMouse or event is InputEventScreenDrag:
		get_viewport().set_input_as_handled()


func pause() -> void:
	if _paused or _finished:
		return
	_paused = true
	_dim.visible = true
	if _held != &"":
		# Whatever was held goes back where it came from.
		_going_back[_held] = {"from": ghost_rect_room(_held).position, "t": 0.0}
		_held = &""
	for player in [_full, _thin, _place, _bag]:
		player.stream_paused = true
	queue_redraw()


func resume() -> void:
	if not _paused:
		return
	_paused = false
	_dim.visible = false
	for player in [_full, _thin, _place, _bag]:
		player.stream_paused = false


func is_paused() -> bool:
	return _paused


func _notification(what: int) -> void:
	# Native builds; the web says so through visibilitychange (see _ready).
	if what in [NOTIFICATION_APPLICATION_FOCUS_OUT, NOTIFICATION_APPLICATION_PAUSED] \
			and not OS.has_feature("web"):
		pause()


func _on_visibility_change(_args: Array) -> void:
	if _document and _document.hidden:
		pause()


# After the tab has been away, Safari can leave the page's sound stopped (the
# Loss found this, Dan, 2026-10-27). The tap that resumes restarts every
# audio context the page made, inside the browser's own tap handler, which
# is the only place a phone lets sound start.
func _bring_sound_back() -> void:
	JavaScriptBridge.eval("""
		if (!window.thresholdMournerSound) {
			const back = window.thresholdMournerSound = { on: false, away: false };
			document.addEventListener('visibilitychange', () => {
				if (document.hidden) back.away = true;
			});
			const tapped = () => {
				if (!back.on || document.hidden) return;
				for (const ctx of window.thresholdAudioContexts || []) {
					if (ctx.state === 'closed') continue;
					if (ctx.state !== 'running') {
						ctx.resume();
					} else if (back.away) {
						ctx.suspend();
						ctx.resume();
					}
				}
				back.away = false;
			};
			for (const type of ['touchend', 'mouseup', 'keydown']) {
				window.addEventListener(type, tapped, true);
			}
		}
		window.thresholdMournerSound.on = true;
		window.thresholdMournerSound.away = false;
	""", true)


# --- For tests, the playtest overlay and the browser tests.

func room() -> RefCounted:
	return _room


func held() -> StringName:
	return _held


func is_going_back(id: StringName) -> bool:
	return id in _going_back


func is_settling(id: StringName) -> bool:
	return id in _settling


## A thing's tap area on screen now, in the game's screen units.
func thing_rect(id: StringName) -> Rect2:
	var r := _to_screen(_room.rect_of(id))
	return Rect2(get_global_transform() * r.position, r.size * get_global_transform().get_scale())


## A place's drop area on screen, in the game's screen units.
func place_rect(place: StringName) -> Rect2:
	var r := _to_screen(MournerRoom.PLACES[place])
	return Rect2(get_global_transform() * r.position, r.size * get_global_transform().get_scale())


## The held thing's ghost on screen, or an empty rect.
func ghost_rect() -> Rect2:
	if _held == &"":
		return Rect2()
	var r := _to_screen(ghost_rect_room(_held))
	return Rect2(get_global_transform() * r.position, r.size * get_global_transform().get_scale())


func sound_level(which: String) -> float:
	match which:
		"full":
			return _levels[_full]
		"thin":
			return _levels[_thin]
	return 0.0


func is_sound_playing() -> bool:
	return _thin.playing and not _thin.stream_paused


func last_sound() -> String:
	if _bag.playing:
		return "bag"
	if _place.playing:
		return "place"
	return ""


## Seconds into the chapter, for the playtest overlay's clock.
func playtest_time() -> float:
	return _room.time


func probe_state() -> Dictionary:
	var things := {}
	for t: Dictionary in MournerRoom.THINGS:
		var id: StringName = t.id
		if not (id in _room.placed or id in _room.visible_unplaced()):
			continue
		var r := thing_rect(id)
		var p := place_rect(t.to)
		things[String(id)] = {
			"x": r.get_center().x, "y": r.get_center().y, "w": r.size.x, "h": r.size.y,
			"movable": id in _room.movable(), "placed": id in _room.placed,
			"toX": p.get_center().x, "toY": p.get_center().y,
		}
	return {
		"stage": Stage.keys()[_room.stage],
		"time": _room.time,
		"light": _room.light,
		"things": things,
		"held": String(_held),
		"paused": _paused,
		"sound": is_sound_playing(),
		"full": sound_level("full"),
		"thin": sound_level("thin"),
	}
