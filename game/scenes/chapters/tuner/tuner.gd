extends Control
## The Tuner, rough M2 playable (DAS-135). Month 12: listening for the baby
## on a home doppler. Static on a small grainy screen, a waveform across the
## bottom of it, and two large knobs with no labels. Turn them until a signal
## comes through. First the fridge's hum, a steady rhythm that turns out to
## be nothing (the levity), then a faster pulse under the noise, then the
## heartbeat, and the picture clears. Beats: docs/design/story-beats.md §5
## (Dan approved 2026-10-25). No words: the heartbeat is the line.
##
## The search itself is tuner_signal.gd. The scan picture and every sound
## are PLACEHOLDERS (tools/tuner/make_placeholder_audio.py, the shader).
##
## The chapter only reports that it finished (no Stoic/Vulnerable answer),
## and never touches the House or saved state: the chapter runner and the
## core table do that. Leaving part-way gives no result, so the next visit
## starts again from the static. Hiding the tab pauses everything until the
## next tap, and never saves.

signal finished

const TunerSignal := preload("res://scenes/chapters/tuner/tuner_signal.gd")
const TunerKnob := preload("res://scenes/chapters/tuner/tuner_knob.gd")
const SCREEN_SHADER := preload("res://scenes/chapters/tuner/tuner_screen.gdshader")
# PLACEHOLDER sounds, generated by tools/tuner/make_placeholder_audio.py.
const STATIC_SOUND := preload("res://assets/audio/tuner/placeholder_static.wav")
const HUM_SOUND := preload("res://assets/audio/tuner/placeholder_hum.wav")
const CLICK_SOUND := preload("res://assets/audio/tuner/placeholder_click.wav")
const HEARTBEAT_SOUND := preload("res://assets/audio/tuner/placeholder_heartbeat.wav")
## The heartbeat's speed in the sound file: 150 a minute.
const HEARTBEAT_PERIOD := 0.4
## The hum swells 72 times a minute in its sound file.
const HUM_PERIOD := 1.0 / 1.2

const BACKGROUND := Color("#1C1916")
const ACCENT := Color("#C4A574")
const INK := Color("#F4EFE6")
const MARGIN := 32.0
## How quickly each sound's loudness follows the signal (per second).
const VOLUME_EASE := 4.0

## Tests turn this off and move the clock themselves with advance().
var auto_advance := true

var _signal := TunerSignal.new()
var _knobs: Array = []  # The two TunerKnob controls.
var _screen: ColorRect
var _waveform: Control
var _dim: ColorRect
var _paused := false
var _finished := false
var _static: AudioStreamPlayer
var _hum: AudioStreamPlayer
var _heartbeat: AudioStreamPlayer
var _click: AudioStreamPlayer
var _levels := {}  # Each looping player's current loudness, 0 to 1.
var _document: JavaScriptObject
var _visibility_callback: JavaScriptObject


func _ready() -> void:
	set_anchors_preset(PRESET_FULL_RECT)
	mouse_filter = MOUSE_FILTER_STOP
	var background := ColorRect.new()
	background.color = BACKGROUND
	background.set_anchors_preset(PRESET_FULL_RECT)
	background.mouse_filter = MOUSE_FILTER_IGNORE
	add_child(background)
	_screen = ColorRect.new()
	_screen.name = "Screen"
	_screen.mouse_filter = MOUSE_FILTER_IGNORE
	var screen_material := ShaderMaterial.new()
	screen_material.shader = SCREEN_SHADER
	_screen.material = screen_material
	add_child(_screen)
	_waveform = Control.new()
	_waveform.name = "Waveform"
	_waveform.mouse_filter = MOUSE_FILTER_IGNORE
	_waveform.draw.connect(_draw_waveform)
	add_child(_waveform)
	for k in 2:
		var dial: Control = TunerKnob.new()
		dial.name = "Knob%d" % (k + 1)
		dial.set_value(_signal.knobs[k])
		dial.turned.connect(_on_knob_turned.bind(k))
		add_child(dial)
		_knobs.append(dial)
	_dim = ColorRect.new()
	_dim.color = Color(0, 0, 0, 0.55)
	_dim.set_anchors_preset(PRESET_FULL_RECT)
	_dim.mouse_filter = MOUSE_FILTER_IGNORE
	_dim.visible = false
	add_child(_dim)
	_build_sound()
	resized.connect(_layout)
	_layout()
	if OS.has_feature("web"):
		_bring_sound_back()
		# Hiding the tab pauses the search; Godot doesn't say so on the web.
		_document = JavaScriptBridge.get_interface("document")
		_visibility_callback = JavaScriptBridge.create_callback(_on_visibility_change)
		_document.addEventListener("visibilitychange", _visibility_callback)
	_update(0.0)


func _build_sound() -> void:
	_static = _player(STATIC_SOUND, "Static")
	_hum = _player(HUM_SOUND, "Hum")
	_heartbeat = _player(HEARTBEAT_SOUND, "Heartbeat")
	_click = _player(CLICK_SOUND, "Click")
	# The loops all start together and run under everything, silent until
	# their signal comes through, so the heartbeat on screen and in the ear
	# stay in step.
	for player in [_static, _hum, _heartbeat]:
		_levels[player] = 0.0
		player.volume_db = linear_to_db(0.0001)
		player.play()


func _player(stream: AudioStream, node_name: String) -> AudioStreamPlayer:
	var player := AudioStreamPlayer.new()
	player.name = node_name
	player.stream = stream
	add_child(player)
	return player


func _exit_tree() -> void:
	if OS.has_feature("web"):
		JavaScriptBridge.eval("if (window.thresholdTunerSound) window.thresholdTunerSound.on = false;", true)
	if _document:
		_document.removeEventListener("visibilitychange", _visibility_callback)
		_document = null


# Knobs low on each side where the thumbs are when the phone is sideways,
# the screen between them. On an upright screen the knobs sit under it.
func _layout() -> void:
	var w := size.x
	var h := size.y
	if w <= 0.0 or h <= 0.0:
		return
	var knob_size := clampf(minf(w, h) * 0.3, 120.0, 260.0)
	var screen_rect: Rect2
	if w >= h:
		var side := knob_size + MARGIN * 2.0
		screen_rect = Rect2(side, MARGIN, w - side * 2.0, h - MARGIN * 2.0)
		_knobs[0].position = Vector2(MARGIN, h - MARGIN - knob_size - h * 0.12)
		_knobs[1].position = Vector2(w - MARGIN - knob_size, h - MARGIN - knob_size - h * 0.12)
	else:
		screen_rect = Rect2(MARGIN, MARGIN * 2.0, w - MARGIN * 2.0, (w - MARGIN * 2.0) * 1.1)
		var y := minf(screen_rect.end.y + MARGIN * 2.0, h - MARGIN - knob_size)
		_knobs[0].position = Vector2(MARGIN * 2.0, y)
		_knobs[1].position = Vector2(w - MARGIN * 2.0 - knob_size, y)
	for k: Control in _knobs:
		k.size = Vector2(knob_size, knob_size)
	var picture_h := screen_rect.size.y * 0.72
	_screen.position = screen_rect.position
	_screen.size = Vector2(screen_rect.size.x, picture_h)
	_waveform.position = screen_rect.position + Vector2(0.0, picture_h)
	_waveform.size = Vector2(screen_rect.size.x, screen_rect.size.y - picture_h)
	(_screen.material as ShaderMaterial).set_shader_parameter("aspect", _screen.size.x / maxf(_screen.size.y, 1.0))


func _process(delta: float) -> void:
	if auto_advance:
		advance(delta)


## Moves the chapter's clock on by `delta` seconds (nothing moves while paused).
func advance(delta: float) -> void:
	if _paused or _finished:
		return
	var before: int = _signal.stage
	_signal.advance(delta)
	if before != _signal.stage:
		_on_stage(_signal.stage)
	_update(delta)


func _on_stage(stage: int) -> void:
	match stage:
		TunerSignal.Stage.HUM_LOST:
			_click.play()  # The fridge's motor clicks off.
			_set_level(_hum, 0.0)
		TunerSignal.Stage.THROUGH:
			for k: Control in _knobs:
				k.let_go()
		TunerSignal.Stage.DONE:
			_finished = true
			for player in [_static, _hum, _heartbeat]:
				player.stop()
			finished.emit()


func _on_knob_turned(value: float, which: int) -> void:
	_signal.set_knob(which, value)
	_knobs[which].set_value(_signal.knobs[which])


func _update(delta: float) -> void:
	var s: float = _signal.strength()
	var clarity: float = _signal.clarity
	var kind: StringName = _signal.signal_kind()
	var stage: int = _signal.stage
	var hum_level := 0.0
	var heart_level := 0.0
	match stage:
		TunerSignal.Stage.SEARCH_HUM:
			hum_level = 0.6 * s * s
		TunerSignal.Stage.HUM:
			hum_level = 0.85 * s
		TunerSignal.Stage.SEARCH_BABY:
			heart_level = 0.55 * s * s  # A faster pulse, faint, under the noise.
		TunerSignal.Stage.THROUGH, TunerSignal.Stage.DONE:
			heart_level = lerpf(0.55, 1.0, clarity)
	var static_level := 0.5 * (1.0 - 0.9 * clarity) * (1.0 - 0.5 * s if stage != TunerSignal.Stage.THROUGH else 1.0)
	if stage == TunerSignal.Stage.HUM_LOST:
		static_level = 0.55
	_ease(_static, static_level, delta)
	_ease(_hum, hum_level, delta)
	_ease(_heartbeat, heart_level, delta)
	var mat := _screen.material as ShaderMaterial
	mat.set_shader_parameter("clock", _signal.time)
	mat.set_shader_parameter("clarity", clarity)
	mat.set_shader_parameter("signal_level", s if kind == &"heartbeat" else 0.0)
	mat.set_shader_parameter("hum", hum_level / 0.85 if kind == &"hum" else 0.0)
	mat.set_shader_parameter("beat", _beat() * (heart_level))
	_waveform.queue_redraw()


func _ease(player: AudioStreamPlayer, level: float, delta: float) -> void:
	var now: float = _levels[player]
	now = level if delta <= 0.0 else move_toward(now, level, VOLUME_EASE * delta)
	_set_level(player, now)


func _set_level(player: AudioStreamPlayer, level: float) -> void:
	_levels[player] = level
	player.volume_db = linear_to_db(maxf(level, 0.0001))


## 0 to 1, peaking on each heartbeat: what the screen flickers with.
func _beat() -> float:
	var at := fmod(_signal.time, HEARTBEAT_PERIOD) / HEARTBEAT_PERIOD
	return exp(-at * 8.0)


# The waveform: the only reading the knobs have (UX-DR17). Noise when
# nothing is there; the hum's slow even swell, or the heartbeat's quick
# double pulse, as much as is coming through.
func _draw_waveform() -> void:
	if _waveform.size.x <= 0.0 or _waveform.size.y <= 0.0:
		return
	_waveform.draw_rect(Rect2(Vector2.ZERO, _waveform.size), Color(0.06, 0.055, 0.05))
	var colour := ACCENT.lerp(INK, _signal.strength() * 0.6)
	_waveform.draw_polyline(waveform_points(), colour, 3.0, true)


## The trace as drawn now, in the waveform's own space.
func waveform_points() -> PackedVector2Array:
	var w := _waveform.size.x
	var h := _waveform.size.y
	var s: float = _signal.strength()
	var kind: StringName = _signal.signal_kind()
	var t: float = _signal.time
	var noise := (1.0 - 0.85 * s) * (1.0 - _signal.clarity)
	var points := PackedVector2Array()
	var count := 120
	var rng := RandomNumberGenerator.new()
	rng.seed = int(t * 30.0)  # The noise changes 30 times a second, steady between.
	for k in count + 1:
		var x := float(k) / count
		var y := rng.randf_range(-1.0, 1.0) * noise
		y += s * signal_shape(kind, x * 3.0 - t)
		points.append(Vector2(x * w, h / 2.0 - y * h * 0.38))
	return points


## The signal's shape at `phase` seconds along the trace, from -1 to 1.
static func signal_shape(kind: StringName, phase: float) -> float:
	match kind:
		&"hum":
			# A steady swell, 72 a minute, with the motor's buzz on it.
			var swell := sin(TAU * phase / HUM_PERIOD)
			return 0.75 * swell + 0.15 * sin(TAU * phase * 14.0)
		&"heartbeat":
			# A quick double pulse, 150 a minute.
			var at := fposmod(phase, HEARTBEAT_PERIOD)
			return exp(-pow((at - 0.05) / 0.025, 2.0)) - 0.6 * exp(-pow((at - 0.17) / 0.03, 2.0))
	return 0.0


# --- Pause: hiding the tab stops the search, the sound and the clocks, and
# the next tap brings them back. Never saves.

func _input(event: InputEvent) -> void:
	if not _paused:
		return
	var pressed := false
	if event is InputEventScreenTouch:
		pressed = event.pressed
	elif event is InputEventMouseButton:
		pressed = event.pressed and event.button_index == MOUSE_BUTTON_LEFT
	if pressed:
		get_viewport().set_input_as_handled()
		resume()
	elif event is InputEventMouse or event is InputEventScreenDrag:
		get_viewport().set_input_as_handled()


func pause() -> void:
	if _paused or _finished:
		return
	_paused = true
	_dim.visible = true
	for k: Control in _knobs:
		k.let_go()
	for player in [_static, _hum, _heartbeat, _click]:
		player.stream_paused = true


func resume() -> void:
	if not _paused:
		return
	_paused = false
	_dim.visible = false
	for player in [_static, _hum, _heartbeat, _click]:
		player.stream_paused = false


func is_paused() -> bool:
	return _paused


func _notification(what: int) -> void:
	# Native builds; the web says so through visibilitychange (see _ready).
	if what in [NOTIFICATION_APPLICATION_FOCUS_OUT, NOTIFICATION_APPLICATION_PAUSED] \
			and not OS.has_feature("web"):
		pause()


func _on_visibility_change(_args: Array) -> void:
	if _document and _document.hidden:
		pause()


# After the tab has been away, Safari can leave the page's sound stopped (the
# Loss found this, Dan, 2026-10-27). The tap that resumes restarts every
# audio context the page made, inside the browser's own tap handler, which
# is the only place a phone lets sound start.
func _bring_sound_back() -> void:
	JavaScriptBridge.eval("""
		if (!window.thresholdTunerSound) {
			const back = window.thresholdTunerSound = { on: false, away: false };
			document.addEventListener('visibilitychange', () => {
				if (document.hidden) back.away = true;
			});
			const tapped = () => {
				if (!back.on || document.hidden) return;
				for (const ctx of window.thresholdAudioContexts || []) {
					if (ctx.state === 'closed') continue;
					if (ctx.state !== 'running') {
						ctx.resume();
					} else if (back.away) {
						ctx.suspend();
						ctx.resume();
					}
				}
				back.away = false;
			};
			for (const type of ['touchend', 'mouseup', 'keydown']) {
				window.addEventListener(type, tapped, true);
			}
		}
		window.thresholdTunerSound.on = true;
		window.thresholdTunerSound.away = false;
	""", true)


# --- For tests, the playtest overlay and the browser tests.

func search() -> RefCounted:
	return _signal


func knob(which: int) -> Control:
	return _knobs[which]


func sound_level(which: String) -> float:
	match which:
		"static":
			return _levels[_static]
		"hum":
			return _levels[_hum]
		"heartbeat":
			return _levels[_heartbeat]
	return 0.0


func is_sound_playing() -> bool:
	return _static.playing and not _static.stream_paused


## Seconds into the chapter, for the playtest overlay's clock.
func playtest_time() -> float:
	return _signal.time


func probe_state() -> Dictionary:
	var centres := []
	for k: Control in _knobs:
		var c := k.get_global_rect().get_center()
		centres.append({"x": c.x, "y": c.y, "r": k.radius()})
	return {
		"stage": TunerSignal.Stage.keys()[_signal.stage],
		"time": _signal.time,
		"knobs": [_signal.knobs.x, _signal.knobs.y],
		"knobCentres": centres,
		"strength": _signal.strength(),
		"clarity": _signal.clarity,
		"paused": _paused,
		"sound": is_sound_playing(),
	}
