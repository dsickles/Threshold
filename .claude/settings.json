{
  "permissions": {
    "deny": [
      "Read(/archive/**)",
      "Edit(/archive/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/godot-setup.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
